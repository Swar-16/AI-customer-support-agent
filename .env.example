APP_ENV=development
APP_NAME=support-ai

AUTH_JWT_SECRET=<generated-secret>
AUTH_JWT_ISSUER=support-ai
AUTH_JWT_AUDIENCE=support-ai-api
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=support_ai
DATABASE_USER=support_ai_admin
DATABASE_PASSWORD=change_me
DATABASE_ECHO=false

DASHBOARD_ANALYTICS_STATEMENT_TIMEOUT_MS=5000
DASHBOARD_ANALYTICS_CACHE_TTL_SECONDS=15
DASHBOARD_ANALYTICS_CACHE_MAX_ENTRIES=256

LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_COMPLETION_TOKENS=1024
GEMINI_TEMPERATURE=0

# TypeSafe AI / Jev Configuration (System One Intent Classification)
# Set USE_JEV_INTENT_CLASSIFICATION=true once you have a TypeSafe API key
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest
TYPESAFE_CONFIDENCE_THRESHOLD=0.70
USE_JEV_INTENT_CLASSIFICATION=false

# Groq Configuration (Legacy / Fallback)

GROQ_API_KEY=groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TEMPERATURE=0

AI_PROVIDER_MAX_CONCURRENCY=2
AI_PROVIDER_QUEUE_TIMEOUT_SECONDS=8
AI_PROVIDER_MINIMUM_START_INTERVAL_SECONDS=1.0

AI_PROVIDER_MAX_RETRIES=3
AI_PROVIDER_RETRY_BASE_DELAY_SECONDS=1.5
AI_PROVIDER_RETRY_MAXIMUM_DELAY_SECONDS=10
AI_PROVIDER_RETRY_JITTER_RATIO=0.20

CONVERSATION_TITLE_ENABLED=true
CONVERSATION_TITLE_MAX_INPUT_CHARACTERS=2000
CONVERSATION_TITLE_TIMEOUT_SECONDS=4
CONVERSATION_TITLE_MAX_COMPLETION_TOKENS=32

EMBEDDING_PROVIDER=jina

JINA_API_KEY=jina-api-key
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_EMBEDDING_DIMENSIONS=1024
JINA_EMBEDDING_TIMEOUT_SECONDS=30

EMBEDDING_BATCH_SIZE=16

QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
QUERY_EMBEDDING_CACHE_MAX_ENTRIES=512

RAG_CONTEXT_MAX_TOKENS=3500
RAG_CONTEXT_MAX_BLOCKS=5
RAG_CONTEXT_MAX_BLOCKS_PER_DOCUMENT=2

CONVERSATION_CONTEXT_MAX_MESSAGES=12
CONVERSATION_CONTEXT_MAX_CHARACTERS=8000
CONVERSATION_CONTEXT_MAX_CHARACTERS_PER_MESSAGE=2000

CONVERSATION_START_IDEMPOTENCY_TTL_SECONDS=86400
CONVERSATION_START_PROCESSING_LEASE_SECONDS=120

KNOWLEDGE_UPLOAD_MAX_BYTES=1048576

REDIS_HOST=localhost
REDIS_PORT=6379

LOG_LEVEL=INFO