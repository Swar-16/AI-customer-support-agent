APP_ENV=development
APP_NAME=support-ai

AUTH_JWT_SECRET=<generated-secret>
AUTH_JWT_ISSUER=support-ai
AUTH_JWT_AUDIENCE=support-ai-api
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=support_ai
DATABASE_USER=support_ai_admin
DATABASE_PASSWORD=change_me
DATABASE_ECHO=false

LLM_PROVIDER=groq

GROQ_API_KEY=groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TEMPERATURE=0

EMBEDDING_PROVIDER=jina

JINA_API_KEY=jina-api-key
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_EMBEDDING_DIMENSIONS=1024
JINA_EMBEDDING_TIMEOUT_SECONDS=30

EMBEDDING_BATCH_SIZE=16

RAG_CONTEXT_MAX_TOKENS=6000
RAG_CONTEXT_MAX_BLOCKS=8

REDIS_HOST=localhost
REDIS_PORT=6379

LOG_LEVEL=INFO